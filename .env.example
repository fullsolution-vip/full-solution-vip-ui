# Database (Supabase)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# App
VITE_APP_URL=http://localhost:3000
VITE_OAUTH_CALLBACK_URL=http://localhost:3000/auth/callback
NODE_ENV=development

# Auth (for future features)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# AI Chatbot (Hugging Face)
HUGGINGFACE_API_KEY=hf_YOUR_HUGGINGFACE_API_KEY_HERE
HUGGINGFACE_API_URL=https://api-inference.huggingface.co/models/deepseek-ai/DeepSeek-V4-Pro:featherless-ai
VITE_HUGGINGFACE_MODEL=deepseek-ai/DeepSeek-V4-Pro:featherless-ai

# WhatsApp Business (optional)
VITE_WHATSAPP_NUMBER=YOUR_WHATSAPP_NUMBER

# Email (Resend)
RESEND_API_KEY=re_YOUR_RESEND_API_KEY_HERE
FROM_EMAIL=noreply@yourdomain.com
ADMIN_EMAIL=your-email@example.com

# Redis Cloud (LangCache)
LANGCACHE_API_KEY=YOUR_LANGCACHE_API_KEY
LANGCACHE_ID=YOUR_LANGCACHE_ID
LANGCACHE_URL=redis://default:YOUR_PASSWORD@YOUR_LANGCACHE_HOST:6379
REDIS_URL=redis://default:YOUR_PASSWORD@YOUR_REDIS_HOST:PORT
